# Copy this file to .env and edit it. .env is ignored by Git: never commit it.

# True on your laptop, False on a live server.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For a live site, e.g. https://yourname.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Public email shown on the site (used by: python manage.py seed_portfolio)
PORTFOLIO_CONTACT_EMAIL=

# Where contact-form messages are emailed. Leave empty to only see them in the admin.
# Without EMAIL_HOST, emails are printed in the terminal instead of sent.
CONTACT_NOTIFY_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
